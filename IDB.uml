@startuml
class communities {
  id: integer <<PK>>
  county: varchar
  zip_code: varchar
  median_housing_price: double
  population: integer
  crime_index: double
  park_count: integer
  health_count: integer
  map_embed_url: text
  street_view_url: text
  transit_score: integer
  latitude: double
  longitude: double
  community_total_affordable_units: integer
  community_housing_count": integer
  transportation_count": integer
}

class housing {
  id: integer <<PK>>
  project_name: varchar
  address: varchar
  zip_code: varchar
  unit_type: varchar
  housing_tenure: varchar
  income_restriction_level: varchar
  total_affordable_units: integer
  total_ada_units: integer
  council_district: varchar
  latitude: double
  longitude: double
  street_view_image: text
  last_synced_at: timestamp
  walk_score: integer
}

class transportation {
  id: integer <<PK>>
  stop_id: varchar
  stop_name: varchar
  latitude: double
  longitude: double
  stop_url: varchar
  map_embed_url: varchar
  street_view_url: varchar
  transport_type: varchar
  routes: varchar
  frequency: varchar
  num_routes: integer
  wheelchair_accessible: varchar
  service_days: varchar
  travel_time_ut: varchar
  travel_time_downtown: varchar
  travel_time_domain: varchar
  travel_time_ut_minutes: integer
  travel_time_downtown_minutes: integer
  travel_time_domain_minutes: integer
  zipcode: varchar

}

class community_housing {
  community_id : integer <<FK>>
  housing_id : integer <<FK>>
}

class community_transportation {
  community_id : integer <<FK>>
  transportation_id : integer <<FK>>
}

class housing_transportation {
  housing_id : integer <<FK>>
  transportation_id : integer <<FK>>
}


communities "0..*" -- "0..*" housing : community_housing
communities "0..*" -- "0..*" transportation : community_transportation
housing "0..*" -- "0..*" transportation : housing_transportation
@enduml